{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato recurso v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1
    },
    "estadoEditorial": {
      "enum": [
        "borrador",
        "en_revision",
        "aprobado"
      ]
    },
    "demostracion": {
      "type": "boolean"
    },
    "tipo": {
      "enum": [
        "portada",
        "mapa",
        "imagen",
        "diagrama"
      ]
    },
    "src": {
      "type": "string",
      "minLength": 1
    },
    "alt": {
      "type": "string",
      "minLength": 1
    },
    "dimensiones": {
      "type": "object",
      "properties": {
        "ancho": {
          "type": "integer",
          "minimum": 1
        },
        "alto": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ancho",
        "alto"
      ],
      "additionalProperties": false
    },
    "leyenda": {
      "type": "string",
      "minLength": 1
    },
    "autoria": {
      "type": "string",
      "minLength": 1
    },
    "derechos": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "estadoEditorial",
    "demostracion",
    "tipo",
    "src",
    "alt",
    "dimensiones",
    "leyenda",
    "autoria",
    "derechos"
  ],
  "additionalProperties": false
}
